#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
PACKAGE_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
compatibility="$PACKAGE_DIR/compatibility.json"
[[ -f "$compatibility" && ! -L "$compatibility" ]] || {
  printf 'pi-openshell: package compatibility metadata is missing: %s\n' "$compatibility" >&2
  exit 1
}
command -v node >/dev/null 2>&1 || { printf 'pi-openshell: node is required\n' >&2; exit 127; }
mapfile -t release < <(node - "$compatibility" <<'NODE'
const fs = require("fs");
const path = process.argv[2];
try {
  const value = JSON.parse(fs.readFileSync(path, "utf8"));
  if (value.schemaVersion !== 1 || value.hostIntegration?.launcherApi !== 1 || value.hostIntegration?.hookApi !== 1 || value.piAssets?.api !== 1) throw new Error("unsupported compatibility API");
  if (!/^[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$/.test(value.environment?.version ?? "")) throw new Error("invalid environment version");
  if (!/^ghcr\.io\/enriqTS\/openshell-environments\/pi:[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$/.test(value.image?.reference ?? "")) throw new Error("invalid release image reference");
  if (!/^sha256:[0-9a-f]{64}$/.test(value.image?.digest ?? "")) throw new Error("invalid release image digest");
  console.log(value.environment.version);
  console.log(value.image.reference);
  console.log(value.image.digest);
} catch (error) {
  console.error(`pi-openshell: invalid compatibility metadata: ${error.message}`);
  process.exit(1);
}
NODE
)
((${#release[@]} == 3)) || exit 1
required_version="${release[0]}"
release_image="${release[1]}@${release[2]}"
default_environments_dir="${XDG_DATA_HOME:-$HOME/.local/share}/openshell-environments/$required_version"
environments_dir="${PI_OPENSHELL_ENVIRONMENTS_DIR:-$default_environments_dir}"

if [[ ! -f "$environments_dir/VERSION" || "$(<"$environments_dir/VERSION")" != "$required_version" || \
      ! -f "$environments_dir/API_VERSION" || "$(<"$environments_dir/API_VERSION")" != 1 ]]; then
  printf 'pi-openshell: openshell-environments %s (API 1) is required at %s\n' "$required_version" "$environments_dir" >&2
  printf 'Install a compatible release or set PI_OPENSHELL_ENVIRONMENTS_DIR for development.\n' >&2
  exit 1
fi
shared_launcher="$environments_dir/bin/openshell-workspace"
[[ -x "$shared_launcher" ]] || { printf 'pi-openshell: shared launcher is not executable: %s\n' "$shared_launcher" >&2; exit 1; }

recovery=0
case "${1:-}" in --recover|--recover-download) recovery=1;; esac
openshell_provider="${PI_OPENSHELL_PROVIDER:-}"
if ((recovery)); then
  openshell_provider=none
elif [[ "$openshell_provider" != none && -f "${PI_CREDENTIALS_PATH:-$HOME/.pi/agent/auth.json}" ]]; then
  [[ -n "$openshell_provider" ]] || openshell_provider="${PI_OPENSHELL_CODEX_PROVIDER:-pi-codex}"
  provider_profile="$PACKAGE_DIR/providers/pi-codex.yaml"
  if ! openshell provider profile export pi-codex >/dev/null 2>&1; then
    openshell provider profile import --file "$provider_profile" >/dev/null
  fi
  provider_helper="$PACKAGE_DIR/lib/pi-openshell-provider"
  [[ -x "$provider_helper" ]] || { printf 'pi-openshell: provider helper is not executable: %s\n' "$provider_helper" >&2; exit 1; }
  printf 'pi-openshell: synchronizing OpenShell provider %s\n' "$openshell_provider" >&2
  PI_OPENSHELL_CODEX_PROVIDER="$openshell_provider" "$provider_helper"
fi

image="${PI_OPENSHELL_IMAGE:-$release_image}"
policy="${PI_OPENSHELL_POLICY:-$environments_dir/clients/pi/policy.yaml}"
launcher_args=(
  --image "$image"
  --policy "$policy"
  --name-prefix pi
  --client-hook "$PACKAGE_DIR/bin/pi-openshell-hook"
  --command /usr/local/bin/pi-openshell-entrypoint
  --command-arg pi
  --recovery-command pi
)
[[ -z "$openshell_provider" || "$openshell_provider" == none ]] || launcher_args+=(--provider "$openshell_provider")
if ((recovery)); then
  recovery_option="$1"
  recovery_sandbox="${2:-}"
  [[ -n "$recovery_sandbox" ]] || { printf 'usage: pi-openshell %s SANDBOX [PI_ARGS...]\n' "$recovery_option" >&2; exit 2; }
  launcher_args+=("$recovery_option" "$recovery_sandbox")
  shift 2
fi
exec "$shared_launcher" "${launcher_args[@]}" -- "$@"
