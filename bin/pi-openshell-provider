#!/usr/bin/env python3
"""Create/update an OpenShell provider from Pi's local OAuth state.

Secrets are passed to the OpenShell CLI through its environment lookup feature,
not as command-line arguments and never into the sandbox environment.
"""
import base64
import json
import os
import subprocess
import sys
from pathlib import Path


def jwt_payload(token):
    try:
        part = token.split(".")[1]
        part += "=" * (-len(part) % 4)
        value = json.loads(base64.urlsafe_b64decode(part).decode())
        return value if isinstance(value, dict) else {}
    except (ValueError, TypeError, UnicodeDecodeError, json.JSONDecodeError):
        return {}


def find_account_id(credential):
    # Pi's auth file deliberately does not duplicate this value. Codex puts it
    # in the OAuth JWT, although the claim name has changed between versions.
    for token in (credential.get("access"), credential.get("id_token")):
        if not isinstance(token, str):
            continue
        claims = jwt_payload(token)
        for key in ("chatgpt_account_id", "account_id", "accountId"):
            value = claims.get(key)
            if isinstance(value, str) and value:
                return value
        auth = claims.get("https://api.openai.com/auth")
        if isinstance(auth, dict):
            for key in ("chatgpt_account_id", "account_id", "accountId"):
                value = auth.get(key)
                if isinstance(value, str) and value:
                    return value
    return credential.get("account_id") or credential.get("accountId")


def run_openshell(args, env):
    return subprocess.run(["openshell", *args], env=env, check=False)


def main():
    provider_name = os.environ.get("PI_OPENSHELL_CODEX_PROVIDER", "codex")
    auth_path = Path(os.environ.get("PI_CREDENTIALS_PATH", Path.home() / ".pi/agent/auth.json"))
    try:
        auth = json.loads(auth_path.read_text())
        credential = auth.get("openai-codex")
    except (OSError, json.JSONDecodeError) as error:
        print(f"pi-openshell-provider: cannot read {auth_path}: {error}", file=sys.stderr)
        return 1

    if not isinstance(credential, dict) or credential.get("type") != "oauth":
        print(f"pi-openshell-provider: no openai-codex OAuth credentials in {auth_path}", file=sys.stderr)
        return 1

    values = {
        "CODEX_AUTH_ACCESS_TOKEN": credential.get("access"),
        "CODEX_AUTH_REFRESH_TOKEN": credential.get("refresh"),
        "CODEX_AUTH_ACCOUNT_ID": find_account_id(credential),
        "CODEX_AUTH_ID_TOKEN": credential.get("id_token"),
    }
    missing = [key for key in ("CODEX_AUTH_ACCESS_TOKEN", "CODEX_AUTH_REFRESH_TOKEN", "CODEX_AUTH_ACCOUNT_ID") if not values[key]]
    if missing:
        print("pi-openshell-provider: missing Codex OAuth fields: " + ", ".join(missing), file=sys.stderr)
        print("Log in with pi first, and ensure its OAuth token contains an account ID.", file=sys.stderr)
        return 1

    env = os.environ.copy()
    env.update({key: value for key, value in values.items() if value})
    credentials = []
    for key in ("CODEX_AUTH_ACCESS_TOKEN", "CODEX_AUTH_REFRESH_TOKEN", "CODEX_AUTH_ACCOUNT_ID", "CODEX_AUTH_ID_TOKEN"):
        if values[key]:
            credentials.extend(("--credential", key))

    # Avoid treating a normal "already exists" response as an error. A
    # provider is workspace state, so refresh its credentials on each run.
    exists = subprocess.run(
        ["openshell", "provider", "get", provider_name],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    if exists:
        result = run_openshell(["provider", "update", provider_name, *credentials], env)
    else:
        result = run_openshell(
            ["provider", "create", "--name", provider_name, "--type", "codex", *credentials],
            env,
        )
    if result.returncode != 0:
        print(f"pi-openshell-provider: could not create or update provider {provider_name!r}", file=sys.stderr)
        return result.returncode or 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
