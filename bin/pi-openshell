#!/usr/bin/env bash
set -Eeuo pipefail

# Resolve the repository even when this script is installed through a symlink.
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
CUSTOMIZATIONS_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"

if [[ -z "${OPENSHELL_GATEWAY:-}" ]]; then
  export OPENSHELL_GATEWAY=local
fi

if [[ ! -d "$PWD" ]]; then
  printf 'pi-openshell: current directory does not exist: %s\n' "$PWD" >&2
  exit 1
fi

if ! command -v openshell >/dev/null 2>&1; then
  printf 'pi-openshell: openshell CLI is not installed or not on PATH\n' >&2
  exit 127
fi

# Attach gateway-owned providers without copying Pi's auth.json into the
# sandbox. Set PI_OPENSHELL_PROVIDER=none to disable this behavior.
openshell_provider="${PI_OPENSHELL_PROVIDER:-}"
if [[ "$openshell_provider" != "none" && -f "${PI_CREDENTIALS_PATH:-$HOME/.pi/agent/auth.json}" ]]; then
  if [[ -z "$openshell_provider" ]]; then
    openshell_provider="${PI_OPENSHELL_CODEX_PROVIDER:-pi-codex}"
  fi
  provider_profile="$CUSTOMIZATIONS_DIR/providers/pi-codex.yaml"
  if ! openshell provider profile export pi-codex >/dev/null 2>&1; then
    openshell provider profile import --file "$provider_profile" >/dev/null
  fi
  provider_helper="$CUSTOMIZATIONS_DIR/bin/pi-openshell-provider"
  if [[ ! -x "$provider_helper" ]]; then
    printf 'pi-openshell: provider helper is not executable: %s\n' "$provider_helper" >&2
    exit 1
  fi
  printf 'pi-openshell: synchronizing OpenShell provider %s\n' "$openshell_provider" >&2
  PI_OPENSHELL_CODEX_PROVIDER="$openshell_provider" "$provider_helper"
fi

# Use the repository root as the transferred workspace and preserve ordinary
# .git directories separately. Linked worktrees and external object stores can
# reference host paths, so they are deliberately unsupported.
host_workspace="$(pwd -P)"
relative_workdir=""
git_dir=""
git_name=""
git_email=""
if git -C "$host_workspace" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  repo_root="$(git -C "$host_workspace" rev-parse --show-toplevel)"
  repo_root="$(cd -- "$repo_root" && pwd -P)"
  case "$host_workspace/" in
    "$repo_root/"*) ;;
    *)
      printf 'pi-openshell: current directory is outside resolved repository root\n' >&2
      exit 1
      ;;
  esac
  relative_workdir="${host_workspace#"$repo_root"}"
  host_workspace="$repo_root"

  git_dir="$(git -C "$repo_root" rev-parse --absolute-git-dir)"
  git_dir="$(readlink -f -- "$git_dir")"
  if [[ "$git_dir" != "$repo_root/.git" || ! -d "$repo_root/.git" || -L "$repo_root/.git" ]]; then
    printf 'pi-openshell: only an ordinary repository-root .git directory is supported\n' >&2
    exit 1
  fi
  "$CUSTOMIZATIONS_DIR/bin/pi-openshell-git-check" "$git_dir"
  git_name="$(git -C "$repo_root" config user.name || true)"
  git_email="$(git -C "$repo_root" config user.email || true)"
fi

# OpenShell preserves the source directory basename when uploading. Keep the
# repository under /workspace and execute from the matching relative path.
sandbox_workspace="/workspace/$(basename -- "$host_workspace")"
sandbox_workdir="$sandbox_workspace$relative_workdir"

# OpenShell names must be stable enough for logs but unique per invocation.
project_name="$(basename -- "$host_workspace" | tr '[:upper:]' '[:lower:]' | tr -cs '[:lower:][:digit:]' '-' | sed 's/^-*//; s/-*$//')"
project_name="${project_name:-workspace}"
# OpenShell limits sandbox names to 19 characters.
project_name="${project_name:0:8}"
sandbox_name="pi-${project_name}-$$"

sandbox_created=0
tracked_manifest=""
download_stage=""
config_stage=""
cleanup() {
  local status=$?
  local sync_failed=0
  trap - EXIT INT TERM

  if (( sandbox_created )); then
    printf '\npi-openshell: downloading workspace changes...\n' >&2
    if [[ -n "$git_dir" ]]; then
      download_stage="$(mktemp -d)"
      if ! openshell sandbox download \
        "$sandbox_name" "$sandbox_workspace" "$download_stage"; then
        sync_failed=1
      elif ! rsync -a -- "$download_stage/" "$host_workspace/"; then
        sync_failed=1
      elif ! rsync -a --delete -- \
        "$download_stage/.git/" "$host_workspace/.git/"; then
        sync_failed=1
      else
        # Archive extraction cannot delete host files. Remove only paths that
        # were tracked before upload and are absent from the sandbox snapshot;
        # ignored host files were never uploaded and must remain untouched.
        while IFS= read -r -d '' tracked_path; do
          if [[ ! -e "$download_stage/$tracked_path" && \
                ! -L "$download_stage/$tracked_path" ]]; then
            rm -f -- "$host_workspace/$tracked_path" || sync_failed=1
          fi
        done <"$tracked_manifest"
      fi
    elif ! openshell sandbox download \
      "$sandbox_name" "$sandbox_workspace" "$host_workspace"; then
      sync_failed=1
    fi

    if (( sync_failed )); then
      printf 'pi-openshell: download/sync failed; sandbox retained as %s\n' \
        "$sandbox_name" >&2
      (( status == 0 )) && status=1
    else
      openshell sandbox delete "$sandbox_name" >/dev/null 2>&1 || true
    fi
  fi

  [[ -z "$download_stage" ]] || rm -rf -- "$download_stage"
  [[ -z "$tracked_manifest" ]] || rm -f -- "$tracked_manifest"
  [[ -z "$config_stage" ]] || rm -rf -- "$config_stage"
  exit "$status"
}
trap cleanup EXIT

if [[ -n "$git_dir" ]]; then
  if ! command -v rsync >/dev/null 2>&1; then
    printf 'pi-openshell: rsync is required to safely restore Git workspaces\n' >&2
    exit 127
  fi
  tracked_manifest="$(mktemp)"
  git -C "$host_workspace" ls-files -z >"$tracked_manifest"
fi

# Copy only explicitly allowlisted preferences. Resource locations are replaced
# with paths baked from this reviewed repository; credentials, provider config,
# trust state, sessions, arbitrary paths, and command-bearing settings are
# never included.
settings_helper="$CUSTOMIZATIONS_DIR/bin/pi-openshell-settings.mjs"
host_settings="${PI_OPENSHELL_SETTINGS_PATH:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/settings.json}"
if ! command -v node >/dev/null 2>&1; then
  printf 'pi-openshell: node is required to sanitize Pi settings\n' >&2
  exit 127
fi
if [[ ! -f "$settings_helper" ]]; then
  printf 'pi-openshell: settings sanitizer is missing: %s\n' "$settings_helper" >&2
  exit 1
fi
config_stage="$(mktemp -d)"
node "$settings_helper" "$host_settings" "$config_stage/pi-openshell-settings.json"

printf 'pi-openshell: uploading %s to sandbox %s\n' "$host_workspace" "$sandbox_name" >&2

# Create an idle sandbox with the normally filtered working tree first. A
# separate upload can then disable filtering for .git alone; applying
# --no-git-ignore to sandbox create would also expose every ignored file.
sandbox_args=(
  --name "$sandbox_name"
  --from "$CUSTOMIZATIONS_DIR"
  --upload "$host_workspace:/workspace"
  --no-tty
)
openshell_policy="${PI_OPENSHELL_POLICY:-$CUSTOMIZATIONS_DIR/openshell-policy.yaml}"
sandbox_args+=(--policy "$openshell_policy")
if [[ -n "${openshell_provider:-}" && "$openshell_provider" != "none" ]]; then
  sandbox_args+=(--provider "$openshell_provider")
fi

if ! openshell sandbox create "${sandbox_args[@]}" -- true; then
  if openshell sandbox get "$sandbox_name" >/dev/null 2>&1; then
    printf 'pi-openshell: creation failed; sandbox retained as %s\n' "$sandbox_name" >&2
  fi
  exit 1
fi
sandbox_created=1

if [[ -n "$git_dir" ]]; then
  printf 'pi-openshell: uploading Git metadata from %s\n' "$git_dir" >&2
  if ! openshell sandbox upload --no-git-ignore \
    "$sandbox_name" "$git_dir" "$sandbox_workspace"; then
    sandbox_created=0
    printf 'pi-openshell: Git metadata upload failed; sandbox retained as %s\n' \
      "$sandbox_name" >&2
    exit 1
  fi
fi

printf 'pi-openshell: uploading sanitized Pi settings\n' >&2
if ! openshell sandbox upload --no-git-ignore \
  "$sandbox_name" "$config_stage/pi-openshell-settings.json" /tmp; then
  sandbox_created=0
  printf 'pi-openshell: Pi settings upload failed; sandbox retained as %s\n' \
    "$sandbox_name" >&2
  exit 1
fi

exec_args=(
  --name "$sandbox_name"
  --workdir "$sandbox_workdir"
  --env "HOME=/home/pi"
  --env "PI_CODING_AGENT_DIR=/home/pi/.pi/agent"
  --env "PI_OPENSHELL_SANITIZED_SETTINGS=/tmp/pi-openshell-settings.json"
  --tty
)
# Git identity is non-secret and is scoped to this command. Host credential
# helpers, signing keys, and global Git configuration are never transferred.
if [[ -n "$git_name" ]]; then
  exec_args+=(--env "GIT_AUTHOR_NAME=$git_name" --env "GIT_COMMITTER_NAME=$git_name")
fi
if [[ -n "$git_email" ]]; then
  exec_args+=(--env "GIT_AUTHOR_EMAIL=$git_email" --env "GIT_COMMITTER_EMAIL=$git_email")
fi

# OpenShell executes commands directly rather than through the image
# ENTRYPOINT, so invoke the credential adapter explicitly.
openshell sandbox exec "${exec_args[@]}" -- \
  /usr/local/bin/pi-openshell-entrypoint pi "$@"
