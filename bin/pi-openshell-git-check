#!/usr/bin/env python3
"""Reject Git metadata that could copy host credentials or escape the repo."""
import os
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


def fail(message):
    print(f"pi-openshell: unsafe Git metadata: {message}", file=sys.stderr)
    raise SystemExit(1)


def config_entries(path):
    result = subprocess.run(
        ["git", "config", "--no-includes", "--file", str(path), "--null", "--list"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        fail(f"cannot parse {path}: {result.stderr.decode(errors='replace').strip()}")
    for record in result.stdout.split(b"\0"):
        if not record:
            continue
        key, separator, value = record.partition(b"\n")
        if not separator:
            fail(f"malformed entry in {path}")
        yield key.decode(errors="replace").lower(), value.decode(errors="replace")


def remote_url_is_sensitive(value):
    if value.startswith(("ext::", "fd::")):
        return True
    parsed = urlsplit(value)
    if parsed.scheme and (parsed.username is not None or parsed.password is not None):
        return True
    return bool(parsed.query or parsed.fragment)


def main():
    if len(sys.argv) != 2:
        print("usage: pi-openshell-git-check GIT_DIR", file=sys.stderr)
        return 2
    git_dir = Path(sys.argv[1])

    forbidden_files = list(git_dir.rglob("alternates")) + list(git_dir.rglob("commondir"))
    if forbidden_files:
        fail(f"linked object/worktree file present: {forbidden_files[0]}")

    for root, directories, files in os.walk(git_dir, followlinks=False):
        for name in directories + files:
            path = Path(root, name)
            if path.is_symlink():
                fail(f"symlink present: {path}")

    configs = [git_dir / "config", git_dir / "config.worktree"]
    configs.extend(git_dir.glob("modules/**/config"))
    for config in configs:
        if not config.is_file():
            continue
        for key, value in config_entries(config):
            if (
                key.startswith("credential.")
                or key == "credential.helper"
                or key.endswith(".extraheader")
                or key in {"http.proxy", "https.proxy", "core.sshcommand"}
                or key.startswith("include.")
                or key.startswith("includeif.")
                or key.startswith("url.")
            ):
                fail(f"credential-capable setting {key!r} in {config}")
            if key.startswith("remote.") and key.endswith((".url", ".pushurl")):
                if remote_url_is_sensitive(value):
                    fail(f"credential-bearing or executable remote URL in {config}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
