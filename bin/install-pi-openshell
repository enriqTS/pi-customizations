#!/usr/bin/env bash
set -Eeuo pipefail

# Self-contained installer/manager for the published pi-openshell host
# integration package. Never depends on a local checkout of this or the
# openshell-environments repository beyond what it downloads itself.

CANONICAL_REPO="enriqTS/pi-customizations"
CANONICAL_ENVIRONMENTS_REPO="https://github.com/enriqTS/openshell-environments.git"
RELEASE_BASE_URL="${PI_OPENSHELL_INSTALL_BASE_URL:-https://github.com/$CANONICAL_REPO/releases/download}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
PACKAGES_DIR="$DATA_HOME/pi-openshell"
SYMLINK="$BIN_HOME/pi"

stage=""
trap 'rm -rf -- "${stage:-}"' EXIT

fail() {
  printf 'install-pi-openshell: %s\n' "$1" >&2
  exit "${2:-1}"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required" 127
}

active_version() {
  [[ -L "$SYMLINK" ]] || return 0
  local target
  target="$(readlink -f -- "$SYMLINK" 2>/dev/null || true)"
  case "$target" in
    "$PACKAGES_DIR"/*/bin/pi) basename "$(dirname -- "$(dirname -- "$target")")" ;;
  esac
}

resolve_latest() {
  require_cmd curl
  require_cmd node
  curl -fsSL "https://api.github.com/repos/$CANONICAL_REPO/releases" | node -e '
    const data = JSON.parse(require("fs").readFileSync(0, "utf8"));
    const match = Array.isArray(data) && data.find((r) => typeof r.tag_name === "string" && /^pi-openshell-v[0-9]/.test(r.tag_name));
    if (!match) { console.error("install-pi-openshell: no pi-openshell release found"); process.exit(1); }
    process.stdout.write(match.tag_name.slice("pi-openshell-v".length));
  '
}

download_and_verify() {
  local version="$1" dest="$2"
  local base="$RELEASE_BASE_URL/pi-openshell-v${version}"
  require_cmd curl
  require_cmd sha256sum
  curl -fsSL -o "$dest/pi-openshell-${version}.tar.gz" "$base/pi-openshell-${version}.tar.gz"
  curl -fsSL -o "$dest/SHA256SUMS" "$base/SHA256SUMS"
  (cd "$dest" && sha256sum -c --ignore-missing SHA256SUMS) || fail "checksum verification failed for $version"
}

verify_attestation() {
  local archive="$1"
  command -v gh >/dev/null 2>&1 || return 0
  if gh attestation verify "$archive" --repo "$CANONICAL_REPO" >/dev/null 2>&1; then
    printf 'install-pi-openshell: verified build provenance attestation\n' >&2
  else
    printf 'install-pi-openshell: warning: could not verify build provenance attestation\n' >&2
  fi
}

# Exact member set, per-file SHA-256, safe paths, and required members —
# the same rules as contracts/pi-host-integration.schema.json, reimplemented
# inline so this installer has no dependency on a local checkout of either
# repository.
validate_package() {
  local dir="$1"
  require_cmd node
  node - "$dir" <<'NODE'
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const dir = process.argv[2];
const fail = (m) => { console.error(`install-pi-openshell: invalid package: ${m}`); process.exit(1); };
let manifest;
try { manifest = JSON.parse(fs.readFileSync(path.join(dir, "manifest.json"), "utf8")); } catch (e) { fail(`unreadable manifest.json: ${e.message}`); }
if (manifest.schemaVersion !== 1 || manifest.name !== "pi-openshell" || manifest.launcherApi !== 1 || manifest.hookApi !== 1) fail("unsupported schema/API");
if (!/^[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$/.test(manifest.version ?? "")) fail("invalid version");
const safePath = /^(bin\/(pi|pi-openshell|pi-openshell-hook)|lib\/[^/].*|providers\/[^/].*|compatibility\.json)$/;
const seen = new Set();
for (const file of manifest.files ?? []) {
  const p = file.path;
  if (typeof p !== "string" || !safePath.test(p) || p.includes("..") || p.startsWith("/")) fail(`unsafe or unreviewed path: ${p}`);
  if (!["0644", "0755"].includes(file.mode)) fail(`invalid mode: ${p}`);
  if (!/^[0-9a-f]{64}$/.test(file.sha256 ?? "")) fail(`invalid checksum entry: ${p}`);
  if (seen.has(p)) fail(`duplicate path: ${p}`);
  seen.add(p);
  const full = path.join(dir, p);
  const stat = fs.lstatSync(full, { throwIfNoEntry: false });
  if (!stat || !stat.isFile() || stat.isSymbolicLink()) fail(`missing or invalid file: ${p}`);
  const hash = crypto.createHash("sha256").update(fs.readFileSync(full)).digest("hex");
  if (hash !== file.sha256) fail(`checksum mismatch: ${p}`);
}
for (const required of ["bin/pi", "bin/pi-openshell", "bin/pi-openshell-hook", "compatibility.json"]) {
  if (!seen.has(required)) fail(`missing required member: ${required}`);
}
NODE
}

compatible_environment_version() {
  local dir="$1"
  node - "$dir" <<'NODE'
const fs = require("fs");
const path = require("path");
const dir = process.argv[2];
const fail = (m) => { console.error(`install-pi-openshell: ${m}`); process.exit(1); };
let value;
try { value = JSON.parse(fs.readFileSync(path.join(dir, "compatibility.json"), "utf8")); } catch (e) { fail(`unreadable compatibility.json: ${e.message}`); }
if (value.schemaVersion !== 1 || value.hostIntegration?.launcherApi !== 1 || value.hostIntegration?.hookApi !== 1 || value.piAssets?.api !== 1) fail("unsupported compatibility API");
if (!/^ghcr\.io\/enriqts\/openshell-environments\/pi:[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$/.test(value.image?.reference ?? "")) fail("invalid release image reference");
if (!/^sha256:[0-9a-f]{64}$/.test(value.image?.digest ?? "")) fail("invalid release image digest");
if (!/^[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$/.test(value.environment?.version ?? "")) fail("invalid environment version");
process.stdout.write(value.environment.version);
NODE
}

# Mirrors bin/install-openshell-environments's own logic exactly, without
# depending on a colocated version-pin file (this runs from inside an
# extracted package, parameterized by the version compatibility.json names).
ensure_environment() {
  local required_version="$1"
  local env_dir="${PI_OPENSHELL_ENVIRONMENTS_DIR:-$DATA_HOME/openshell-environments/$required_version}"
  if [[ -f "$env_dir/VERSION" && "$(<"$env_dir/VERSION")" == "$required_version" \
        && -f "$env_dir/API_VERSION" && "$(<"$env_dir/API_VERSION")" == 1 ]]; then
    return 0
  fi
  [[ -z "${PI_OPENSHELL_ENVIRONMENTS_DIR:-}" ]] || fail "PI_OPENSHELL_ENVIRONMENTS_DIR does not contain a compatible openshell-environments $required_version"
  [[ ! -e "$env_dir" ]] || fail "openshell-environments destination exists but is incompatible: $env_dir"
  require_cmd git
  printf 'install-pi-openshell: installing openshell-environments %s\n' "$required_version" >&2
  local source="${PI_OPENSHELL_ENVIRONMENTS_SOURCE:-$CANONICAL_ENVIRONMENTS_REPO}"
  mkdir -p -- "$(dirname -- "$env_dir")"
  git clone --quiet --branch "v$required_version" --depth 1 "$source" "$env_dir"
  if [[ "$(<"$env_dir/VERSION")" != "$required_version" || "$(<"$env_dir/API_VERSION")" != 1 ]]; then
    rm -rf -- "$env_dir"
    fail "installed openshell-environments dependency is incompatible"
  fi
}

activate_version() {
  local version="$1"
  local target="$PACKAGES_DIR/$version"
  [[ -x "$target/bin/pi" ]] || fail "$version is not installed"
  mkdir -p -- "$BIN_HOME"
  local tmp_link="$BIN_HOME/.pi.install-pi-openshell.tmp"
  ln -sfn -- "$target/bin/pi" "$tmp_link"
  mv -T -- "$tmp_link" "$SYMLINK"
  printf 'install-pi-openshell: %s -> %s\n' "$SYMLINK" "$version" >&2
}

install_version() {
  local version="$1"
  [[ "$version" != "latest" ]] || version="$(resolve_latest)"
  local target="$PACKAGES_DIR/$version"
  if [[ -d "$target" ]]; then
    printf 'install-pi-openshell: %s is already installed\n' "$version" >&2
  else
    mkdir -p -- "$PACKAGES_DIR"
    stage="$(mktemp -d "$PACKAGES_DIR/.stage-XXXXXX")"
    download_and_verify "$version" "$stage"
    verify_attestation "$stage/pi-openshell-${version}.tar.gz"
    local extracted="$stage/extracted"
    mkdir -p -- "$extracted"
    tar -xzf "$stage/pi-openshell-${version}.tar.gz" -C "$extracted"
    validate_package "$extracted"
    local required_env
    required_env="$(compatible_environment_version "$extracted")"
    ensure_environment "$required_env"
    mv -T -- "$extracted" "$target"
    rm -rf -- "$stage"
    stage=""
  fi
  activate_version "$version"
}

cmd_list() {
  local current
  current="$(active_version)"
  local found=0
  if [[ -d "$PACKAGES_DIR" ]]; then
    for dir in "$PACKAGES_DIR"/*/; do
      [[ -d "$dir" ]] || continue
      local v
      v="$(basename -- "$dir")"
      case "$v" in .*) continue ;; esac
      found=1
      if [[ "$v" == "$current" ]]; then printf '%s (active)\n' "$v"; else printf '%s\n' "$v"; fi
    done
  fi
  ((found)) || printf 'no versions installed\n'
}

cmd_uninstall() {
  local version="$1" force="${2:-}"
  local target="$PACKAGES_DIR/$version"
  [[ -d "$target" ]] || fail "$version is not installed"
  if [[ "$(active_version)" == "$version" ]]; then
    [[ "$force" == "--force" ]] || fail "$version is active; pass --force to uninstall it and remove $SYMLINK"
    rm -f -- "$SYMLINK"
  fi
  rm -rf -- "$target"
  printf 'install-pi-openshell: removed %s\n' "$version" >&2
}

usage() {
  printf 'usage: install-pi-openshell {install|upgrade|downgrade} {VERSION|latest} | uninstall VERSION [--force] | list\n' >&2
  exit 2
}

command="${1:-install}"
case "$command" in
  install | upgrade | downgrade)
    version="${2:-}"
    [[ -n "$version" ]] || fail "a version is required, e.g. install-pi-openshell $command 0.1.0"
    install_version "$version"
    ;;
  uninstall)
    version="${2:-}"
    [[ -n "$version" ]] || fail "a version is required, e.g. install-pi-openshell uninstall 0.1.0"
    cmd_uninstall "$version" "${3:-}"
    ;;
  list) cmd_list ;;
  *) usage ;;
esac
